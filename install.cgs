repos = [
    "github:flipoyo/MOLONARI-hardware",
    { repository = "github:flipoyo/firmware" },
    { repository = "github:flipoyo/MOLO-firmware-config" , relative_path = "config" },
    { repository = "github:flipoyo/.memory", relative_path = ".cgitsync/.memory", fallback_branch = "main", private = true, writable = true, nested_config = "disabled" },
]

[project]
name = "MOLONARI-hardware"
default_branch = "CGS-MOLO"
